{
  "name": "judicial-memory-lab",
  "version": "1.0.0",
  "description": "司法書士の学習用Markdownから、図解と想起練習の動画を制作",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.24.1",
    "@remotion/cli": "4.0.379",
    "@remotion/tailwind-v4": "4.0.379",
    "@remotion/zod-types": "4.0.379",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "googleapis": "^166.0.0",
    "mp3-duration": "^1.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.379",
    "tailwindcss": "4.0.0",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.379",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.6.0",
    "tsx": "4.23.15",
    "typescript": "5.8.2"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "build-video": "npx ts-node scripts/generate-audio.ts && npx remotion render src/index.ts LawEnglish out/video.mp4 && npx ts-node scripts/cleanup-audio.ts",
    "generate-video": "node -e \"throw new Error(\"Legacy Legal English publishing is retired. Use the Judicial Memory workflow.\")\"",
    "generate-input": "node -e \"throw new Error(\"Random Legal English generation is retired. Use original Learning OS Markdown.\")\"",
    "memory:prepare": "node --import tsx scripts/memory/prepare.ts",
    "memory:catalog": "node --import tsx scripts/memory/import-catalog.ts",
    "memory:check": "node --import tsx --test scripts/memory/timeline.test.ts",
    "shorts:prepare": "node --import tsx scripts/shorts/prepare.ts",
    "shorts:check": "node --import tsx --test scripts/shorts/shorts.test.ts",
    "shorts:review": "node --import tsx scripts/shorts/review.ts"
  },
  "sideEffects": [
    "*.css"
  ]
}
